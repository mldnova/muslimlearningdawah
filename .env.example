
# Password for the admin panel at /admin (share it only with the team)
ADMIN_PASSWORD=

# Set automatically when you connect a Vercel Blob store to the project
# (older stores set BLOB_READ_WRITE_TOKEN instead).
# Without either, admin edits are saved to local files (fine for development only).
BLOB_STORE_ID=

# Long random string used to encrypt form messages in storage. Generate one with:
#   openssl rand -base64 32
# Keep it the same forever — changing it makes older inbox messages unreadable.
SUBMISSIONS_SECRET=
